From: tt-bh-linux <noreply@tenstorrent.com>
Subject: [PATCH] drivers/virtio/virtio_mmio: tt-bh sel_generation handshake

The tt-bh-linux daemon (host-side virtio-mmio emulation) doesn't watch
every standard register write — it polls a custom `sel_generation`
register at MMIO offset 0x01c. The guest is expected to bump that
register after each daemon-monitored write and spin until the daemon
increments it back. Without the bumps the daemon sits forever in
Phase 2 (feature negotiation) and Phase 3 (queue address exchange)
waiting for `curr_gen != prev_gen`.

The patched Linux kernel mirrors this protocol via
`wait_sel_generation_update` in the same file, gated on the `sw_impl`
flag the daemon writes to MMIO offset 0x018. This patch adds the
equivalent in U-Boot.

Sites threaded through, mirroring the kernel exactly:

- virtio_mmio_get_features: bump after each DEVICE_FEATURES_SEL write
  (twice — for high-32 and low-32 selectors).
- virtio_mmio_set_features: bump after each DRIVER_FEATURES_SEL +
  DRIVER_FEATURES write (four sites total).
- virtio_mmio_setup_vq: ONE bump after the full queue config block;
  the daemon's Phase 3 reads every queue register in a single shot
  when it sees the bump.

Real hardware leaves `sw_impl` at 0 (read-only), so the bumps short-
circuit and standard virtio-mmio behavior is preserved. Tested only
on tt-bh-linux software emulation. See tt-bh-linux #49.

---
--- a/drivers/virtio/virtio_mmio.c
+++ b/drivers/virtio/virtio_mmio.c
@@ -14,10 +14,42 @@
 #include <virtio_ring.h>
 #include <linux/bug.h>
 #include <linux/compat.h>
+#include <linux/delay.h>
 #include <linux/err.h>
 #include <linux/io.h>
 #include "virtio_mmio.h"
 
+/*
+ * tt-bh sw_impl handshake: the host-side daemon polls SEL_GENERATION
+ * to know when to react to standard-register writes. Bump after every
+ * write the daemon should see, then spin until the daemon writes back
+ * something other than `prev + 1`. No-op when sw_impl == 0 (real
+ * hardware). See tt-bh-linux #49.
+ */
+static int virtio_mmio_sw_impl_sync(struct virtio_mmio_priv *priv)
+{
+	u32 prev, n;
+
+	if (!priv->sw_impl)
+		return 0;
+
+	prev = readl(priv->base + VIRTIO_MMIO_SEL_GENERATION);
+	writel(prev + 1, priv->base + VIRTIO_MMIO_SEL_GENERATION);
+	/*
+	 * 100 ms timeout: the daemon's poll loop is sub-µs but we account
+	 * for scheduler tail latency. The kernel's analogous helper uses
+	 * 1 s; we tighten because U-Boot has no preemption noise.
+	 */
+	for (n = 0; n < 100000; n++) {
+		if (readl(priv->base + VIRTIO_MMIO_SEL_GENERATION) != prev + 1)
+			return 0;
+		udelay(1);
+	}
+	debug("virtio-mmio: sel_generation ack timed out (sw_impl=%u)\n",
+	      priv->sw_impl);
+	return -ETIMEDOUT;
+}
+
 static int virtio_mmio_get_config(struct udevice *udev, unsigned int offset,
 				  void *buf, unsigned int len)
 {
@@ -156,10 +188,14 @@
 	struct virtio_mmio_priv *priv = dev_get_priv(udev);
 
 	writel(1, priv->base + VIRTIO_MMIO_DEVICE_FEATURES_SEL);
+	if (virtio_mmio_sw_impl_sync(priv))
+		return -ETIMEDOUT;
 	*features = readl(priv->base + VIRTIO_MMIO_DEVICE_FEATURES);
 	*features <<= 32;
 
 	writel(0, priv->base + VIRTIO_MMIO_DEVICE_FEATURES_SEL);
+	if (virtio_mmio_sw_impl_sync(priv))
+		return -ETIMEDOUT;
 	*features |= readl(priv->base + VIRTIO_MMIO_DEVICE_FEATURES);
 
 	return 0;
@@ -177,12 +213,20 @@
 	}
 
 	writel(1, priv->base + VIRTIO_MMIO_DRIVER_FEATURES_SEL);
+	if (virtio_mmio_sw_impl_sync(priv))
+		return -ETIMEDOUT;
 	writel((u32)(uc_priv->features >> 32),
 	       priv->base + VIRTIO_MMIO_DRIVER_FEATURES);
+	if (virtio_mmio_sw_impl_sync(priv))
+		return -ETIMEDOUT;
 
 	writel(0, priv->base + VIRTIO_MMIO_DRIVER_FEATURES_SEL);
+	if (virtio_mmio_sw_impl_sync(priv))
+		return -ETIMEDOUT;
 	writel((u32)uc_priv->features,
 	       priv->base + VIRTIO_MMIO_DRIVER_FEATURES);
+	if (virtio_mmio_sw_impl_sync(priv))
+		return -ETIMEDOUT;
 
 	return 0;
 }
@@ -259,6 +303,16 @@
 		writel(1, priv->base + VIRTIO_MMIO_QUEUE_READY);
 	}
 
+	/*
+	 * tt-bh: single bump after the full queue config block — the
+	 * daemon's Phase 3 reads QUEUE_SEL + NUM + DESC/AVAIL/USED + READY
+	 * in one shot when it sees the bump. See tt-bh-linux #49.
+	 */
+	if (virtio_mmio_sw_impl_sync(priv)) {
+		err = -ETIMEDOUT;
+		goto error_bad_pfn;
+	}
+
 	return vq;
 
 error_bad_pfn:
@@ -376,6 +430,15 @@
 	}
 	uc_priv->vendor = readl(priv->base + VIRTIO_MMIO_VENDOR_ID);
 
+	/*
+	 * tt-bh sw_impl flag: the daemon writes 1 here during cold-start
+	 * to signal it needs the SEL_GENERATION handshake. Real hardware
+	 * leaves the slot at 0, in which case all the bumps short-circuit
+	 * and we behave like a stock virtio-mmio. See tt-bh-linux #49.
+	 */
+	priv->sw_impl = readl(priv->base + VIRTIO_MMIO_SW_IMPL);
+	debug("(%s): sw_impl=%u\n", udev->name, priv->sw_impl);
+
 	if (priv->version == 1)
 		writel(PAGE_SIZE, priv->base + VIRTIO_MMIO_GUEST_PAGE_SIZE);
 
--- a/drivers/virtio/virtio_mmio.h
+++ b/drivers/virtio/virtio_mmio.h
@@ -24,6 +24,12 @@
 /* Virtio vendor ID - Read Only */
 #define VIRTIO_MMIO_VENDOR_ID		0x00c
 
+/* tt-bh: software-implementation flag (1 = host daemon, 0 = hardware) */
+#define VIRTIO_MMIO_SW_IMPL		0x018
+
+/* tt-bh: handshake counter for the sel_generation protocol */
+#define VIRTIO_MMIO_SEL_GENERATION	0x01c
+
 /*
  * Bitmask of the features supported by the device (host)
  * (32 bits per set) - Read Only
@@ -125,6 +131,11 @@
 struct virtio_mmio_priv {
 	void __iomem *base;
 	u32 version;
+	/*
+	 * tt-bh: 1 if the host implementation needs the sel_generation
+	 * handshake. Read from MMIO once during probe; const afterwards.
+	 */
+	u32 sw_impl;
 };
 
 #endif /* _LINUX_VIRTIO_MMIO_H */
