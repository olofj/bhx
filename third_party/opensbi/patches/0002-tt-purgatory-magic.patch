+/* bhx#166 Phase 1: announce parked-in-warmboot to the PCIe host.
+ *
+ * Called from sbi_exit() right before sbi_hsm_exit() jumps into the
+ * HSM warmboot wait loop. We write a fixed magic to a known offset
+ * within the firmware's reserved DRAM range; the bhx daemon polls
+ * that cell over NoC to learn the L2CPU has parked itself instead
+ * of needing a chip-side reset.
+ *
+ * Only the SRST-issuing hart reaches this hook (peers were halted
+ * by sbi_ipi_send_halt and walked sbi_hsm_hart_stop -> sbi_hsm_exit
+ * directly, bypassing sbi_exit). One write is enough: per-hart
+ * liveness will live elsewhere in the status block in later phases.
+ */
+#define TT_PURGATORY_STATUS_OFFSET	0x000E0000UL
+#define TT_PURGATORY_STATUS_PARKED	0x5f5f44454b524150UL  /* "PARKED__" LE */
+
+static void tt_purgatory_final_exit(void)
+{
+	struct sbi_scratch *scratch = sbi_scratch_thishart_ptr();
+	volatile unsigned long *status =
+		(volatile unsigned long *)(scratch->fw_start +
+					   TT_PURGATORY_STATUS_OFFSET);
+
+	*status = TT_PURGATORY_STATUS_PARKED;
+	__asm__ volatile("fence ow,ow" : : : "memory");
+}
+
+/* Stub reset device so the kernel sees SBI SRST as supported. Returns
+ * priority 1 (same as syscon-poweroff). Registered in final_init AFTER
+ * fdt_reset_init has scanned for syscon, so on a tie syscon wins; we
+ * only become the active reset device when no other one was registered.
+ * system_reset() returns immediately, letting sbi_system_reset() fall
+ * through to sbi_exit() and ultimately our final_exit hook.
+ */
+static int tt_purgatory_reset_check(u32 reset_type, u32 reset_reason)
+{
+	(void)reset_reason;
+	if (reset_type == SBI_SRST_RESET_TYPE_SHUTDOWN ||
+	    reset_type == SBI_SRST_RESET_TYPE_COLD_REBOOT ||
+	    reset_type == SBI_SRST_RESET_TYPE_WARM_REBOOT)
+		return 1;
+	return 0;
+}
+
+static void tt_purgatory_reset_do(u32 reset_type, u32 reset_reason)
+{
+	(void)reset_type; (void)reset_reason;
+	/* No-op: caller's sbi_system_reset() falls through to sbi_exit(). */
+}
+
+static struct sbi_system_reset_device tt_purgatory_reset_device = {
+	.name = "tt-purgatory",
+	.system_reset_check = tt_purgatory_reset_check,
+	.system_reset = tt_purgatory_reset_do,
+};
+
+static void tt_purgatory_register_reset_device(void)
+{
+	sbi_system_reset_add_device(&tt_purgatory_reset_device);
+}
+
+
 struct sbi_platform_operations generic_platform_ops = {
 	.cold_boot_allowed	= generic_cold_boot_allowed,
 	.nascent_init		= generic_nascent_init,
