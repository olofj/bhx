+/* bhx#166 Phase 1+2: announce parked-in-warmboot to the PCIe host
+ * after multi-hart convergence.
+ *
+ * Called from sbi_exit() right before sbi_hsm_exit() jumps into the
+ * HSM warmboot wait loop. The SRST-issuing hart broadcasts halt-IPIs
+ * before reaching here; peers walk sbi_hsm_hart_stop -> sbi_hsm_exit
+ * (which atomically transitions STOP_PENDING -> STOPPED) and join the
+ * warmboot wait loop on their own. We poll their HSM state until
+ * every peer reaches STOPPED, then write the magic. The host therefore
+ * sees PARKED only when every hart in the tile is quiesced.
+ *
+ * State quiesce on the SRST-issuing hart (clearing pending IPIs,
+ * timer, external IRQs) is already done by sbi_exit's earlier calls
+ * to sbi_timer_exit / sbi_ipi_exit / sbi_irqchip_exit; we don't
+ * duplicate that here.
+ *
+ * Status block layout (extends in later phases):
+ *   +0x00 : status word (PARKED magic / 0)
+ *   +0x08 : peer convergence: bitmask of hart indices that reached
+ *           STOPPED (low 4 bits = harts 0..3 of this tile). The
+ *           SRST-issuing hart's bit is NOT set here (it's about to
+ *           transition itself in sbi_hsm_exit).
+ */
+#define TT_PURGATORY_STATUS_OFFSET	0x000E0000UL
+#define TT_PURGATORY_STATUS_PARKED	0x5f5f44454b524150UL  /* "PARKED__" LE */
+#define TT_PURGATORY_PEERS_OFFSET	(TT_PURGATORY_STATUS_OFFSET + 8)
+
+/* Maximum spin iterations waiting for peers to reach STOPPED. At
+ * 1750 MHz this caps the wait around ~10ms (single inline pause
+ * per iter), well above the ~µs latency of an in-tile IPI dispatch
+ * but short enough that a wedged hart fails fast rather than hanging
+ * the SRST path. */
+#define TT_PURGATORY_PEER_WAIT_ITERS	(64u * 1024u)
+
+static unsigned long tt_purgatory_collect_peers_stopped(u32 self_hartindex)
+{
+	unsigned long mask = 0;
+	u32 i, count = sbi_hart_count();
+
+	for (i = 0; i < count && i < 64; i++) {
+		if (i == self_hartindex)
+			continue;
+		if (__sbi_hsm_hart_get_state(i) == SBI_HSM_STATE_STOPPED)
+			mask |= 1UL << i;
+	}
+	return mask;
+}
+
+static void tt_purgatory_final_exit(void)
+{
+	struct sbi_scratch *scratch = sbi_scratch_thishart_ptr();
+	u32 hartindex = current_hartindex();
+	u32 hart_count = sbi_hart_count();
+	unsigned long expected_mask = 0, peers_mask = 0;
+	unsigned int spin = 0;
+	u32 i;
+	volatile unsigned long *status =
+		(volatile unsigned long *)(scratch->fw_start +
+					   TT_PURGATORY_STATUS_OFFSET);
+	volatile unsigned long *peers =
+		(volatile unsigned long *)(scratch->fw_start +
+					   TT_PURGATORY_PEERS_OFFSET);
+
+	/* Build the expected peer mask: every hart except ourselves. */
+	for (i = 0; i < hart_count && i < 64; i++)
+		if (i != hartindex)
+			expected_mask |= 1UL << i;
+
+	/* Wait for peers to reach STOPPED (they were halted via
+	 * sbi_ipi_send_halt earlier in sbi_system_reset and walk the
+	 * sbi_hsm_hart_stop -> sbi_hsm_exit path on their own).
+	 * Bounded spin; partial convergence still announces PARKED so
+	 * the host can see (and act on) a wedge via the peers field. */
+	while (spin++ < TT_PURGATORY_PEER_WAIT_ITERS) {
+		peers_mask = tt_purgatory_collect_peers_stopped(hartindex);
+		if (peers_mask == expected_mask)
+			break;
+	}
+
+	*peers = peers_mask;
+	__asm__ volatile("fence ow,ow" : : : "memory");
+	*status = TT_PURGATORY_STATUS_PARKED;
+	__asm__ volatile("fence ow,ow" : : : "memory");
+}
+
+/* Stub reset device so the kernel sees SBI SRST as supported. Returns
+ * priority 1 (same as syscon-poweroff). Registered in final_init AFTER
+ * fdt_reset_init has scanned for syscon, so on a tie syscon wins; we
+ * only become the active reset device when no other one was registered.
+ * system_reset() returns immediately, letting sbi_system_reset() fall
+ * through to sbi_exit() and ultimately our final_exit hook.
+ */
+static int tt_purgatory_reset_check(u32 reset_type, u32 reset_reason)
+{
+	(void)reset_reason;
+	if (reset_type == SBI_SRST_RESET_TYPE_SHUTDOWN ||
+	    reset_type == SBI_SRST_RESET_TYPE_COLD_REBOOT ||
+	    reset_type == SBI_SRST_RESET_TYPE_WARM_REBOOT)
+		return 1;
+	return 0;
+}
+
+static void tt_purgatory_reset_do(u32 reset_type, u32 reset_reason)
+{
+	(void)reset_type; (void)reset_reason;
+	/* No-op: caller's sbi_system_reset() falls through to sbi_exit(). */
+}
+
+static struct sbi_system_reset_device tt_purgatory_reset_device = {
+	.name = "tt-purgatory",
+	.system_reset_check = tt_purgatory_reset_check,
+	.system_reset = tt_purgatory_reset_do,
+};
+
+static void tt_purgatory_register_reset_device(void)
+{
+	sbi_system_reset_add_device(&tt_purgatory_reset_device);
+}
+
