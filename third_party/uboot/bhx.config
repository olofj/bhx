#
# bhx U-Boot config fragment. Layered on top of upstream
# `qemu-riscv64_smode_defconfig` via `scripts/kconfig/merge_config.sh`.
# Keep it small — every line here is a delta against an upstream config
# that already does most of what we need.
#
# Bumping U-Boot: the qemu-smode defconfig may change its defaults, so
# `make olddefconfig` after the merge is what shakes out new symbols;
# review the resulting .config diff before committing a version bump.

# --- load address -------------------------------------------------------
# Where the daemon writes u-boot.bin in L2CPU DRAM. Must equal
# `L2CPU_STARTING_ADDRESS[L2CPU_idx] + KERNEL_OFFSET`. For L2CPU 0 that's
# 0x4000_3000_0000 + 0x20_0000 = 0x4000_3020_0000. The qemu-smode default
# is 0x80200000 (qemu-virt's S-mode RAM start) — wrong for us; the linker
# bakes absolute addresses against TEXT_BASE so a mismatched load
# address means relocation breaks before U-Boot has a chance to do
# anything.
#
# All four L2CPUs map their DRAM at the same architectural address from
# the L2CPU's POV (each sees its own DRAM at 0x4000_3000_0000), so a
# single TEXT_BASE works for all four.
CONFIG_TEXT_BASE=0x400030200000
CONFIG_SYS_LOAD_ADDR=0x400030200000

# --- console -------------------------------------------------------------
# The Blackhole guest console is the OpenSBI virtual UART — a 4 KiB ring
# the daemon's chip_console::uart_pass worker drains. OpenSBI exposes it
# to S-mode via SBI_DBCN (debug console) ecalls.
#
# DEBUG_UART_SBI handles pre-relocation putc; SERIAL_SBI_DM is our
# downstream DM serial driver (patches/serial_sbi_dm.c, installed by
# the Makefile after extraction) that handles post-relocation. Without
# the DM driver, U-Boot bails after relocation with "No serial driver
# found" because qemu-riscv64_smode_defconfig's NS16550 + SIFIVE_SERIAL
# can't bind to anything on a platform whose console is the SBI debug
# console (no MMIO UART).
CONFIG_DEBUG_UART=y
CONFIG_DEBUG_UART_SBI=y
CONFIG_SERIAL_SBI_DM=y

# --- device tree ---------------------------------------------------------
# Don't bake a DTB into U-Boot. The daemon writes our blackhole-card.dtb
# to DTB_OFFSET (0x10_0000 from L2CPU DRAM start); OpenSBI passes that
# address to U-Boot in a1, and U-Boot reads it directly.
CONFIG_OF_BOARD=y
# qemu defconfig may set OF_SEPARATE; both can be on but PRIOR_STAGE /
# OF_BOARD beats embedded.
# CONFIG_OF_SEPARATE is not set
# CONFIG_OF_EMBED is not set

# --- virtio (kernel + initrd from disk) ---------------------------------
# Already enabled in qemu-riscv64_smode_defconfig; restated here so a
# defconfig regression upstream doesn't silently turn them off.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_CMD_VIRTIO=y

# --- bootflow + EFI loader ----------------------------------------------
# bootstd auto-discovers extlinux + EFI boot methods on attached disks.
CONFIG_BOOTSTD_DEFAULTS=y
# EFI_LOADER hosts a UEFI runtime so `bootefi bootmgr` can scan the
# ESP, find EFI/BOOT/BOOTRISCV64.EFI (or distro-specific shim), and
# run it. Earlier disabled because of an OOM print during init —
# that was a symptom of the wrong CFG_SYS_SDRAM_BASE (#49 fix); now
# that gd->ram_base lands in real DRAM there's plenty of memory for
# EFI runtime services. M3's main hook.
CONFIG_EFI_LOADER=y
CONFIG_BOOTEFI_BOOTMGR=y
CONFIG_CMD_BOOTEFI=y
CONFIG_CMD_BOOTEFI_BOOTMGR=y
