# Buildroot defconfig for the tt-bh-linux test rootfs.
#
# Targets riscv64 (rv64gc, glibc), ext4 image, busybox-based init,
# auto-login on hvc0, DHCP via slirp.
#
# Only the kernel + OpenSBI we boot with are NOT built here — those
# come from the project root via `tt-bh-linux kernel pull`. Buildroot
# only produces rootfs.ext4.
#
# To regenerate this file from a saved interactive config:
#   make -C buildroot menuconfig
#   make -C buildroot savedefconfig BR2_DEFCONFIG=$PWD/buildroot.config
# which collapses the .config to only non-default lines.

# --- target architecture --------------------------------------------------
BR2_riscv=y

# --- rootfs overlay -------------------------------------------------------
# Path is relative to buildroot's working dir (buildroot-<version>/).
# Our overlay lives at tests/rootfs/overlay; from buildroot's cwd that's
# `../overlay`. Buildroot resolves it once at config time and copies the
# tree over the assembled target rootfs near the end of the build.
BR2_ROOTFS_OVERLAY="../overlay"

# --- toolchain ------------------------------------------------------------
# Default is BR2_TOOLCHAIN_BUILDROOT — builds gcc + glibc from source.
# Slower first build (~20 min) but reproducible from upstream sources.
# A future patch can switch to BR2_TOOLCHAIN_EXTERNAL_BOOTLIN for speed
# if we're cutting builds in CI.

# --- system configuration -------------------------------------------------
# busybox provides init + most utilities. Use busybox's mdev for /dev
# population — udev is overkill here.
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y

# Auto-login on hvc0. The overlay's /etc/inittab overrides the default
# getty line; we still need busybox's getty available for the override
# to work (BR2_PACKAGE_BUSYBOX is on by default).

# Auto-DHCP on eth0 at boot. Buildroot generates an /etc/network/interfaces
# entry from this.
BR2_SYSTEM_DHCP="eth0"

# --- core packages --------------------------------------------------------
# Bash because the soak scripts assume bash idioms (we run helpers on the
# guest occasionally; busybox's ash isn't quite enough).
BR2_PACKAGE_BASH=y

# OpenSSH-compatible mini-SSH daemon. Listens on :22 by default; the
# daemon's slirp forwards 2222 → 22.
BR2_PACKAGE_DROPBEAR=y

# Stress + IO + network test surface. iperf3 small (~150 KB stripped),
# fio ~1 MB, stress-ng ~5 MB, tcpdump ~1 MB.
BR2_PACKAGE_IPERF3=y
BR2_PACKAGE_FIO=y
BR2_PACKAGE_STRESS_NG=y
BR2_PACKAGE_TCPDUMP=y

# Python3 for any scripted helpers we run on the guest. Minimal config
# (no pip, no extension modules); ~10 MB stripped. If the image bloats
# past 64 MiB, drop this first — the soaks can shell out via bash.
BR2_PACKAGE_PYTHON3=y

# --- rootfs image format --------------------------------------------------
BR2_TARGET_ROOTFS_EXT2=y
# Use ext4 (filesystem revision 4), not ext2.
BR2_TARGET_ROOTFS_EXT2_4=y
# Image size: 96 MiB. 64 MiB is too tight once stress-ng + python3 + fio
# all land. Bump if you add more packages; shrink with `e2fsck -f` +
# `resize2fs -M` if you need to.
BR2_TARGET_ROOTFS_EXT2_SIZE="96M"
# Don't gzip the ext4; the daemon mmaps it directly.

# --- disable defaults we don't need ---------------------------------------
# We boot with our own kernel + OpenSBI; don't make buildroot build them.
# (These are off in the base profile anyway, but be explicit.)
# BR2_LINUX_KERNEL is not set
# BR2_TARGET_OPENSBI is not set
