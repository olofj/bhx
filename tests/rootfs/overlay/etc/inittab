# /etc/inittab — bhx test rootfs (overlay copy)
#
# Differs from the busybox default in two ways:
#  1. We auto-login as root on hvc0 (the OpenSBI virt-UART). The
#     `-n -l /bin/sh` flags tell busybox getty to skip the login
#     prompt and exec /bin/sh directly. This rootfs is for soak
#     scripts ONLY — never deploy it anywhere networked.
#  2. We don't run getty on ttyS0/ttyAMA0/etc; the chip exposes only
#     hvc0.
#
# Format: <id>:<runlevels>:<action>:<process>
# (busybox init ignores runlevels.)

# --- system bring-up ------------------------------------------------------
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -o remount,rw /
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/mkdir -p /run/lock/subsys
::sysinit:/sbin/swapon -a
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/etc/init.d/rcS

# --- console / login ------------------------------------------------------
# Auto-login as root on hvc0. -L skips controlling-tty wait, -n skips
# the login prompt, -l runs /bin/sh directly. respawn so a `logout`
# inside the shell brings up another one.
hvc0::respawn:/sbin/getty -L -n -l /bin/sh hvc0 0 vt100

# --- shutdown -------------------------------------------------------------
::ctrlaltdel:/sbin/reboot
::shutdown:/etc/init.d/rcK
::shutdown:/sbin/swapoff -a
::shutdown:/bin/umount -a -r
